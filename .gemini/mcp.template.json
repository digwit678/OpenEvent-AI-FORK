{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=${SUPABASE_PROJECT_REF}",
      "headers": {
        "Authorization": "Bearer ${SUPABASE_ACCESS_TOKEN}"
      }
    },
    "kindly-web-search": {
      "command": "uvx",
      "args": ["kindly-web-search-mcp-server"],
      "env": {
        "SERPER_API_KEY": "${SERPER_API_KEY}",
        "TAVILY_API_KEY": "${TAVILY_API_KEY}",
        "SEARXNG_URL": "${SEARXNG_URL}",
        "KINDLY_WEB_SEARCH_CHROMIUM_PATH": "${KINDLY_WEB_SEARCH_CHROMIUM_PATH}",
        "KINDLY_WEB_SEARCH_PROFILE": "${KINDLY_WEB_SEARCH_PROFILE}",
        "KINDLY_WEB_SEARCH_MAX_RESULTS": "${KINDLY_WEB_SEARCH_MAX_RESULTS}",
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "lsp": {
      "command": "npx",
      "args": ["-y", "@axivo/mcp-lsp@1.0.5"],
      "env": {
        "LSP_FILE_PATH": "${LSP_FILE_PATH}",
        "npm_config_cache": "/tmp/codex-npm-cache"
      }
    },
    "renamify": {
      "command": "npx",
      "args": ["-y", "@renamify/mcp-server"],
      "env": {
        "npm_config_cache": "/tmp/codex-npm-cache"
      }
    },
    "repomapper": {
      "command": "bash",
      "args": ["-lc", "/path/to/OpenEvent-AI/scripts/mcp/repomapper_server.sh"]
    },
    "filescope": {
      "command": "bash",
      "args": ["-lc", "/path/to/OpenEvent-AI/scripts/mcp/filescope_server.sh"]
    },
    "semgrep": {
      "command": "uvx",
      "args": ["semgrep-mcp"],
      "env": {
        "SEMGREP_APP_TOKEN": "${SEMGREP_APP_TOKEN}"
      }
    },
    "apple-notes": {
      "command": "npx",
      "args": ["-y", "apple-notes-mcp"]
    }
  }
}
